    <script>
        const nodes = <?php echo $gameDataJSON; ?>;
        
        let currentNodeIndex = 0;
        let isAnimating = false;
        let startTime = 0;
        let currentRotationAngle = 0;
        let score = 100;
        let lastPenaltySeconds = 0;
        
        let castleScale = 2; 

        const celestialElements = [
            '<div class="moon" style="top: -200px; left: -300px;"></div>',
            '', 
            '<div class="planet jupiter" style="top: -400px; left: -100px;"></div>',
            '<div class="planet saturn" style="top: -150px; left: 100px;"><div class="saturn-ring"></div></div>',
            '<div class="planet neptune" style="top: -300px; left: -400px;"></div>',
            '<div class="venus" style="top: -50px; left: 300px;"></div>'
        ];

        function startGame() {
            document.getElementById('start-screen').style.display = 'none';
            document.getElementById('game-ui').style.display = 'block';
            document.getElementById('question-board').style.display = 'block'; 
            initGame();
        }

        function initGame() {
            const world = document.getElementById('world');
            const R = 900; 

            for(let i=0; i<6; i++) {
                let pathAngle = i * 60; 

                // Inject Sky 
                let skyNode = document.createElement('div');
                skyNode.className = 'sky-face';
                skyNode.style.transform = `rotateY(${pathAngle}deg) translateZ(-1600px)`; 
                skyNode.innerHTML = `<div class="stars"></div>${celestialElements[i]}`;
                world.appendChild(skyNode);

                // Ensure only ONE Grail Castle exists at index 0
                let castleHTML = (i === 0) ? '<div class="castle"></div>' : '';

                // Inject the Path and Castle (if index 0)
                let pathNode = document.createElement('div');
                pathNode.className = 'forest-node';
                pathNode.style.transform = `rotateY(${pathAngle}deg) translateZ(-${R}px)`;
                pathNode.innerHTML = `
                    <div class="dirt-path"></div>
                    ${castleHTML}
                `;
                world.appendChild(pathNode);

                // Trees face the center of the world.
                let treeNode = document.createElement('div');
                treeNode.className = 'forest-node';
                treeNode.dataset.index = i;
                treeNode.style.transform = `rotateY(${pathAngle + 30}deg) translateZ(-${R}px)`;
                
                treeNode.innerHTML = `
                    <div class="tree-container">
                        <button class="tree-button" onclick="checkAnswer(${i})">
                            <span class="answer-text"></span>
                            <div class="tree-canopy-side"></div>
                        </button>
                    </div>
                `;
                world.appendChild(treeNode);
            }
            
            updateTrackRotations();
            void world.offsetWidth; 
            
            startTime = Date.now();
            lastPenaltySeconds = 0;
            loadNode();
        }

        function updateTrackRotations() {
            const world = document.getElementById('world');
            world.style.transform = `translateZ(0px) rotateY(${currentRotationAngle}deg)`;
        }

        function loadNode() {
            const elapsedSeconds = (Date.now() - startTime) / 1000;
            const currentPenalty = Math.floor(elapsedSeconds / 15);
            const penaltyDiff = currentPenalty - lastPenaltySeconds;
            
            if (penaltyDiff > 0) {
                score -= penaltyDiff;
                lastPenaltySeconds = currentPenalty;
            }

            if (currentNodeIndex < nodes.length) {
                const node = nodes[currentNodeIndex];
                
                document.getElementById('title').innerText = node.title;
                document.getElementById('question').innerText = node.question;
                document.getElementById('status').innerText = `Current Path: ${currentNodeIndex + 1} of ${nodes.length}`;
                document.getElementById('running-score').innerText = `Score: ${score}`;
                
                const trees = document.querySelectorAll('.forest-node[data-index]');
                trees.forEach(tree => {
                    const idx = parseInt(tree.dataset.index);
                    
                    // Place Bypass at the 3rd tree to the right (Index 3)
                    if (idx === 3) {
                        tree.querySelector('.answer-text').innerText = "Bypass\n(-4)";
                    } else {
                        // Offset the index for trees 4 and 5 so we don't go out of bounds on our 5-item array
                        const choiceIdx = idx > 3 ? idx - 1 : idx;
                        tree.querySelector('.answer-text').innerText = node.choices[choiceIdx];
                    }
                });
            } else {
                showFinalScreen();
            }
        }

        function showFinalScreen() {
            const elapsedSeconds = (Date.now() - startTime) / 1000;
            const currentPenalty = Math.floor(elapsedSeconds / 15);
            const penaltyDiff = currentPenalty - lastPenaltySeconds;
            
            if (penaltyDiff > 0) {
                score -= penaltyDiff;
                lastPenaltySeconds = currentPenalty;
            }
            score = Math.max(80, Math.min(140, score));
            
            document.getElementById('game-ui').style.display = 'none';
            const finalScreen = document.getElementById('final-screen');
            finalScreen.style.display = 'flex';
            
            document.getElementById('final-score').innerText = score;
            document.getElementById('final-time').innerText = elapsedSeconds.toFixed(1) + "s";

            if (currentPenalty > 0) { document.getElementById('penalty-display').innerText = `(-${currentPenalty} time penalty)`; }

            if (score > 108) {
                document.getElementById('detention-display').innerText = "You have escaped the forest!";
            } else {
                document.getElementById('detention-display').innerText = "You are lost in the woods!";
                document.getElementById('detention-display').style.color = "#ff6b6b";
            }
        }

        // SWAPPED: Right Arrow now adds 60 to the rotation angle
        function nextChoice() {
            if (isAnimating) return;
            isAnimating = true; 
            currentRotationAngle += 60; 
            updateTrackRotations();
            setTimeout(() => { isAnimating = false; }, 800);
        }

        // SWAPPED: Left Arrow now subtracts 60 from the rotation angle
        function prevChoice() {
            if (isAnimating) return;
            isAnimating = true; 
            currentRotationAngle -= 60; 
            updateTrackRotations();
            setTimeout(() => { isAnimating = false; }, 800);
        }

        function checkAnswer(index) {
            if (isAnimating) return;

            let isBypass = (index === 3);
            let isCorrect = false;
            
            if (!isBypass) {
                const correct = nodes[currentNodeIndex].correct;
                const choiceIdx = index > 3 ? index - 1 : index;
                const selected = nodes[currentNodeIndex].choices[choiceIdx];
                if (selected === correct) isCorrect = true;
            }
            
            if (isCorrect || isBypass) {
                score = isBypass ? score - 4 : score + 2;
                document.getElementById('running-score').innerText = `Score: ${score}`;
                isAnimating = true;

                const activeTree = document.querySelector(`.forest-node[data-index='${index}'] button`);
                activeTree.classList.add('tree-open');

                // Zooms in and fades to black
                setTimeout(() => {
                    const world = document.getElementById('world');
                    world.style.transform = `translateZ(600px) rotateY(${currentRotationAngle}deg)`;
                    
                    document.getElementById('fade-overlay').style.opacity = '1';
                    document.getElementById('question-board').style.opacity = '0'; 
                }, 400);

                // Resets world and explicitly animates the castle scaling
                setTimeout(() => {
                    currentNodeIndex++;

                    loadNode(); 

                    if (currentNodeIndex < nodes.length) {
                        const world = document.getElementById('world');
                        const qBoard = document.getElementById('question-board');

                        world.style.transition = 'none';
                        activeTree.classList.remove('tree-open');
                        
                        world.style.transform = `translateZ(-200px) rotateY(${currentRotationAngle}deg)`;
                        void world.offsetWidth; 

                        world.style.transition = 'transform 0.8s cubic-bezier(0.25, 1, 0.3, 1)';
                        world.style.transform = `translateZ(0px) rotateY(${currentRotationAngle}deg)`;
                        
                        document.getElementById('fade-overlay').style.opacity = '0';
                        qBoard.style.transition = 'opacity 0.4s';
                        qBoard.style.opacity = '1';

                        setTimeout(() => {
                            let facingIndex = Math.round(((-currentRotationAngle / 60) % 6 + 6) % 6);
                            
                            // Castle grows massively if facing path 0 (forward), 1 (right), or 5 (left).
                            if (facingIndex === 0 || facingIndex === 1 || facingIndex === 5) {
                                castleScale += 0.5; 
                            } else {
                                castleScale -= 0.5; 
                                if (castleScale < 1) castleScale = 1; 
                            }

                            const castleElement = document.querySelector('.castle');
                            if (castleElement) {
                                castleElement.style.transition = 'transform 0.8s cubic-bezier(0.34, 1.56, 0.64, 1)'; 
                                castleElement.style.transform = `translate(-50%, -100%) translateZ(-600px) scale(${castleScale})`;
                            }
                        }, 400);

                        setTimeout(() => { isAnimating = false; }, 800);
                    }
                }, 1200);

            } else {
                score -= 1;
                document.getElementById('running-score').innerText = `Score: ${score}`;
                alert("Wrong answer! The tree blocks the path. (-1 point)");
            }
        }
    </script>
</body>
</html>
