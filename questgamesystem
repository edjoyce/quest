// SERVER-SIDE QUESTION GENERATION
function buildNode($title, $q, $correct, $prefix = "", $suffix = "") {
    $c = floatval($correct);
    $inc = [];
    $attempts = 0;
    
    // Generate distractors close to the correct answer
    while(count($inc) < 4 && $attempts < 100) {
        $attempts++;
        $offset = rand(-5, 5);
        if ($offset == 0) continue;
        
        // Scale variance for larger numbers
        if ($c > 100) $offset *= 10;
        elseif ($c > 15) $offset *= 2;
        
        $val = $c + $offset;
        if ($val > 0 || $c <= 0) { // allow zero/negative if answer is zero/negative
            $strVal = $prefix . (string)$val . $suffix;
            $correctStr = $prefix . (string)$correct . $suffix;
            if ($strVal !== $correctStr && !isset($inc[$strVal])) {
                $inc[$strVal] = true;
            }
        }
    }
    
    // Failsafe sequential generator if randomization loops too much
    $val = $c + 1;
    while(count($inc) < 4) {
        $strVal = $prefix . (string)$val . $suffix;
        $correctStr = $prefix . (string)$correct . $suffix;
        if ($strVal !== $correctStr && !isset($inc[$strVal])) {
            $inc[$strVal] = true;
        }
        $val++;
    }

    $choices = array_merge([$prefix . (string)$correct . $suffix], array_keys($inc));
    shuffle($choices);

    return [
        "title" => $title,
        "question" => $q,
        "choices" => $choices,
        "correct" => $prefix . (string)$correct . $suffix
    ];
}

function generateHexNodes() {
    $nodes = [];

    // --- SIMPLE MULTIPLICATION (1 to 10) (25 Questions) ---
    for ($i = 1; $i <= 25; $i++) {
        $a = rand(1, 10);
        $b = rand(1, 10);
        
        $nodes[] = buildNode(
            "Node $i: Times Table Thicket", 
            "What is $a x $b?", 
            $a * $b
        );
    }

    return $nodes;
}

$gameDataJSON = json_encode(generateHexNodes());
